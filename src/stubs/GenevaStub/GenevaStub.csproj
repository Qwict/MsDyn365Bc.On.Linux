<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-targeted: BC 27/28 run on .NET 8, BC 29+ on .NET 10. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>OpenTelemetry.Exporter.Geneva</AssemblyName>
    <Version>1.9.0.62</Version>
    <Nullable>enable</Nullable>
    <NoWarn>CA1416</NoWarn>
    <!-- Match the original assembly's public key token for binding redirects -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.9.*" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.*" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.*" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
</Project>
